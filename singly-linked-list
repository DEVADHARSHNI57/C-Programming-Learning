#include <stdio.h>
#include <stdlib.h>

struct  lnode{
    int data;
    struct lnode* next; // self referential structure
};

typedef struct lnode node;

node* head = NULL;

void insertAtBegining(int val){
    node* newNode = (node*)malloc(sizeof(node));
    if(newNode == NULL){
        printf("Out of memory");
        return;
    }
    newNode -> data = val;
    if(head == NULL){
        newNode -> next = NULL;
        head = newNode;
    } else {
        newNode -> next = head;
        head = newNode;
    }
}
void display(){
    if(head == NULL){
        printf("List is empty");
        return;
    }
    node* temp = head;

    printf("Elements in the list are: ");
    while(temp != NULL){
        printf("%d\t", temp -> data);
        temp = temp -> next;
    }


}



